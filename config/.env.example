# Neural Binary Signals - Configurações de Ambiente
# Copie este arquivo para .env e preencha seus valores

# Modo de Operação: "otc" | "open_market" | "both"
TRADING_MODE=both

# Pares preferidos (separados por vírgula)
PREFERRED_PAIRS=EURUSD,GBPUSD,USDJPY,AUDUSD

# Timeframe padrão: M1 | M5 | M15
DEFAULT_TIMEFRAME=M5

# Threshold mínimo de confiança para sinais (0-100)
MIN_CONFIDENCE=75

# Telegram Bot (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API de Dados (opcional - para dados em tempo real)
DATA_API_KEY=
DATA_API_URL=

# Configurações de Risco
MAX_DAILY_SIGNALS=20
COOLDOWN_SECONDS=60
